# Auto-detect text files and normalize line endings.
* text=auto

# Source code — always LF in the repo.
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf

# Windows scripts — CRLF on checkout.
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary — never touch line endings.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.pkl     binary
*.db      binary
*.sqlite  binary
