# Conflux environment template
#
# Copy to .env for local use only. Never commit real API keys.

# Shared OpenAI-compatible key used by both chat and embedding clients.
OPENAI_API_KEY=

# Optional preset-specific overrides. Research profiles choose preset names;
# users choose the provider/model behind each preset in config.yaml or env.
CONFLUX_MODELS__REASONING__API_KEY=
CONFLUX_MODELS__CHEAP__API_KEY=
CONFLUX_MODELS__FLASH__API_KEY=
CONFLUX_MODELS__BALANCED__API_KEY=
CONFLUX_MODELS__VERIFIER__API_KEY=
CONFLUX_EMBEDDING__API_KEY=

# Optional web search provider key when web_search.provider=serpapi.
SERPAPI_API_KEY=

# Optional Semantic Scholar key and client-side request pacing.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1

# Optional config override.
CONFLUX_CONFIG=config.yaml
